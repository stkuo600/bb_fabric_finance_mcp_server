# Deployment target — actual Azure Container Apps convention for this repo.
# Sourced by infra/update.sh and infra/deploy.sh. These are NON-secret
# identifiers (safe to commit). Secrets are injected separately (see README).

RESOURCE_GROUP="mcp_resource_group"
LOCATION="eastasia"
ACR_NAME="bluebellmcpregistry"            # login server: bluebellmcpregistry.azurecr.io
ENVIRONMENT_NAME="managedEnvironment-mcpresourcegrou-b4c5"
APP_NAME="fabric-finance-mcp-server"
IMAGE_NAME="bb-fabric-finance-mcp-server"  # image tag convention = git short SHA
TARGET_PORT="8000"
MIN_REPLICAS="0"
MAX_REPLICAS="10"
CPU="0.5"
MEMORY="1Gi"
